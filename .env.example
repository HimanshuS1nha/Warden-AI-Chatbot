# For docker-compose.yml. Copy to .env and fill in.

# At least 32 random characters, e.g. `openssl rand -hex 32`.
JWT_SECRET_KEY=
# Chat and document ingest need it. Without it the app runs with chat off.
GEMINI_API_KEY=

# Optional.
# WARDEN_PORT=8080
# FRONTEND_URL=http://localhost:8080
# Set to true when the site is served over HTTPS.
# COOKIE_SECURE=false
# POSTGRES_PASSWORD=postgres
# SEED_PASSWORD=warden-demo
# Per-minute limits. Tighten CHAT_RATE_LIMIT for a public demo.
# CHAT_RATE_LIMIT=20
